{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "lib/**"]
		},
		"build:doc": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["^build"]
		},
		"depcheck": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"size": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
